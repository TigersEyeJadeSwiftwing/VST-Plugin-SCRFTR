<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="ShapeTool" />
		<Option pch_mode="2" />
		<Option compiler="cb64bit_gnu_gcc_compiler" />
		<Build>
			<Target title="Win64-Mingw">
				<Option output="..\bin\ShapeTool" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj\Release\" />
				<Option type="1" />
				<Option compiler="cb64bit_gnu_gcc_compiler" />
				<Compiler>
					<Add option="-O" />
					<Add option="-trigraphs" />
					<Add option="-m128bit-long-double" />
					<Add option="-msse4.2" />
					<Add option="-m64" />
					<Add option="-ffinite-math-only" />
					<Add option="-fno-signed-zeros" />
					<Add option="-fno-trapping-math" />
					<Add option="-mfpmath=sse" />
					<Add option="-malign-double" />
					<Add option="-DNDEBUG" />
					<Add option="-DPRECISION_MAX" />
					<Add directory="..\irrlicht\include" />
				</Compiler>
				<Linker>
					<Add option="-trigraphs" />
					<Add option="-m128bit-long-double" />
					<Add option="-msse4.2" />
					<Add option="-m64" />
					<Add option="-ffinite-math-only" />
					<Add option="-fno-signed-zeros" />
					<Add option="-fno-trapping-math" />
					<Add option="-mfpmath=sse" />
					<Add option="-malign-double" />
				</Linker>
			</Target>
		</Build>
		<Unit filename="..\shared\custdata_types.h" />
		<Unit filename="shapetool.cpp" />
		<Extensions>
			<code_completion />
			<envvars />
			<debugger />
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
