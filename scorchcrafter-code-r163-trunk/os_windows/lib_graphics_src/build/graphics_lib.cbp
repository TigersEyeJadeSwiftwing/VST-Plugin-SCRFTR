<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="graphics_lib" />
		<Option pch_mode="2" />
		<Option compiler="tdm_mingw64" />
		<Build>
			<Target title="MinGW-32">
				<Option output="..\..\lib\libgraphics_32" prefix_auto="1" extension_auto="1" />
				<Option working_dir="" />
				<Option object_output="obj\Release\" />
				<Option type="2" />
				<Option compiler="mingww32" />
				<Compiler>
					<Add option="-m32" />
					<Add option="-DWINDOWS" />
					<Add option="-D_WINDOWS" />
					<Add option="-DWIN32" />
					<Add option="-D_USE_MATH_DEFINES" />
					<Add option="-DCRT_SECURE_NO_WARNINGS=1" />
					<Add option="-D_CRT_SECURE_NO_WARNINGS=1" />
					<Add option="-DCRT_SECURE_NO_DEPRECATE=1" />
					<Add option="-D_CRT_SECURE_NO_DEPRECATE=1" />
					<Add option="-DNDEBUG" />
					<Add option="-DEXPORTS" />
					<Add option="-DPNG_NO_MNG_FEATURES" />
					<Add option="-DPNG_STATIC" />
					<Add option="-DMINGW32" />
					<Add option="-D_MINGW32_" />
					<Add option="-D__MINGW32__" />
					<Add option="-DGNUC" />
					<Add option="-D_GNUC_" />
					<Add option="-DZ_PREFIX" />
				</Compiler>
				<Linker>
					<Add option="-m32" />
				</Linker>
			</Target>
			<Target title="MinGW-64">
				<Option output="..\..\lib\libgraphics_64" prefix_auto="1" extension_auto="1" />
				<Option working_dir="" />
				<Option object_output="obj\Release\" />
				<Option type="2" />
				<Option compiler="mingww64" />
				<Compiler>
					<Add option="-m64" />
					<Add option="-DWINDOWS" />
					<Add option="-D_WINDOWS" />
					<Add option="-DWIN64" />
					<Add option="-D_USE_MATH_DEFINES" />
					<Add option="-DCRT_SECURE_NO_WARNINGS=1" />
					<Add option="-D_CRT_SECURE_NO_WARNINGS=1" />
					<Add option="-DCRT_SECURE_NO_DEPRECATE=1" />
					<Add option="-D_CRT_SECURE_NO_DEPRECATE=1" />
					<Add option="-DNDEBUG" />
					<Add option="-DEXPORTS" />
					<Add option="-DPNG_NO_MNG_FEATURES" />
					<Add option="-DPNG_STATIC" />
					<Add option="-DMINGW32" />
					<Add option="-D_MINGW32_" />
					<Add option="-D__MINGW32__" />
					<Add option="-DGNUC" />
					<Add option="-D_GNUC_" />
					<Add option="-DZ_PREFIX" />
				</Compiler>
				<Linker>
					<Add option="-m64" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-O2" />
			<Add option="-w" />
			<Add option="-trigraphs" />
			<Add option="-m128bit-long-double" />
			<Add option="-ffinite-math-only" />
			<Add option="-fno-signed-zeros" />
			<Add option="-fno-trapping-math" />
			<Add option="-ffast-math" />
			<Add option="-malign-double" />
			<Add option="-DNDEBUG" />
			<Add directory="..\..\lib_graphics_src" />
		</Compiler>
		<ResourceCompiler>
			<Add directory="..\..\lib_graphics_src" />
		</ResourceCompiler>
		<Linker>
			<Add option="-trigraphs" />
			<Add option="-m128bit-long-double" />
			<Add option="-ffinite-math-only" />
			<Add option="-fno-signed-zeros" />
			<Add option="-fno-trapping-math" />
